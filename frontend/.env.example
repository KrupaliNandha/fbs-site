# Optional: only set if the browser should call the API on another origin.
# Leave empty to use same-origin `/api/*` rewrites to the backend.
# NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-side + rewrite target for the standalone backend
AUTH_API_URL=http://localhost:4000

# Existing public frontend keys
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
