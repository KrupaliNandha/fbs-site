PORT=4000
NODE_ENV=development

# Comma-separated origins allowed to call this API with credentials
CORS_ORIGINS=http://localhost:3000

# MySQL auth database
AUTH_DB_HOST=127.0.0.1
AUTH_DB_PORT=3306
AUTH_DB_USER=root
AUTH_DB_PASSWORD=
AUTH_DB_NAME=fbs_auth
AUTH_DB_CONNECTION_LIMIT=10

# Required in production
AUTH_SESSION_SECRET=change-me-to-a-long-random-string
